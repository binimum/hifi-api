CLIENT_ID=
CLIENT_SECRET=
USER_ID=
REFRESH_TOKEN=
COUNTRY_CODE=

# Optional unrestricted credential for search, albums, artists, playlists, etc.
# Prefer a refreshable credential (an account without an active subscription is fine).
CATALOG_CLIENT_ID=
CATALOG_CLIENT_SECRET=
CATALOG_REFRESH_TOKEN=
CATALOG_USER_ID=
# Alternatively provide a static bearer token (it cannot be refreshed automatically).
# CATALOG_TOKEN=

USE_PROXIES=False
ROTATE_PROXIES_ON_REFRESH=False
PROXIES_FILE=proxies.txt
MAX_RETRIES=2
# WARNING: If set to True, the app will expose the host IP if all proxies fail or proxies.txt is misconfigured!
FALLBACK_TO_DIRECT_CONNECTION=False
# Override the User-Agent sent to Tidal
# USER_AGENT=okhttp/5.3.2
# Enable verbose logging of every upstream request (status, headers, body)
# DEV_MODE=True
